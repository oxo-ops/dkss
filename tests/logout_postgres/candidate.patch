+"""Isolation candidate only: existing #403 DB registry is authoritative.
+Requires explicit schema+activation before normal sign-in; no live activation.
+Demo bypass requires the preceding server-side public-demo validation.
+"""
+from flask import session,g,request,redirect,abort
+from flask.sessions import SecureCookieSessionInterface
+from . import auth_session_registry as registry
+class SessionInterface(SecureCookieSessionInterface):
+ def save_session(self,app,state,response):
+  if g.get('normal_session_no_cookie') or g.get('authority_api_rejected'):return
+  return super().save_session(app,state,response)
+def required_policy():
+ # This enforced build never interprets absent/version0 policy as compatibility.
+ # No environment OFF switch. Missing/corrupt DB yields 503, not old-cookie access.
+ if not registry.enforced():registry._failure()
+def issue():
+ required_policy()
+ # Existing login has already populated validated immutable account identity.
+ from .models import User
+ user=User.query.filter_by(company_code=session.get('company_code'),username=session.get('username')).one()
+ registry.issue(user)
+def require_session():
+ if g.get('verified_public_demo_session'):return None
+ if not session.get('username'):return None
+ required_policy()
+ if not session.get('auth_session_token'):
+  g.normal_session_no_cookie=True
+  if request.endpoint=='login' and request.method=='GET':
+   g.normal_session_no_cookie=False;session.clear();return redirect('/login')
+  session.clear()
+  return {'ok':False,'reauthentication_required':True,'message':'再ログインが必要です。入力中の画面は閉じず、保存状況を確認してください。'},401,{'Cache-Control':'no-store'}
+ return registry.require_session()
+def revoke():
+ if g.get('verified_public_demo_session'):return
+ required_policy()
+ registry.revoke_current()
