+"""Read-only previous-month projection candidate; product wiring not yet applied."""
+from datetime import date,timedelta
+import json
+FIXED='daily_inspection_truck_trailer'
+def previous_month(*,company,vehicle,checklist_id,year,month,active_day,current_items,load):
+ try:current=date(int(year),int(month),int(active_day))
+ except (ValueError,TypeError):return None
+ if current.day!=1 or not company or not vehicle:return None
+ if not current_items or not any(x.get('fixed_template_code')==FIXED for x in current_items):return None
+ previous=current-timedelta(days=1)
+ rows=load(company,vehicle,checklist_id,previous)
+ if len(rows)>1:raise ValueError('DUPLICATE_PREVIOUS_RECORD')
+ result={'date':previous.isoformat(),'label':f'{previous.day}日','weekday':'月火水木金土日'[previous.weekday()],'values':{},'status':None,'result_id':None}
+ if not rows:return result
+ row=rows[0]
+ if (row.company_code!=company or row.vehicle_record_id!=vehicle or row.checklist_id!=checklist_id or (int(row.year),int(row.month),int(row.day))!=(previous.year,previous.month,previous.day)):raise ValueError('SCOPE_MISMATCH')
+ snap=json.loads(row.checklist_snapshot_json or '{}');old=[x for x in snap.get('items',[]) if x.get('item_type')=='check']
+ if not any(x.get('fixed_template_code')==FIXED for x in snap.get('items',[])):return result
+ current_checks=[x for x in current_items if x.get('item_type')=='check']
+ bycode={}
+ for no,item in enumerate(old):
+  code=item.get('item_code')
+  if not code:continue
+  if code in bycode:raise ValueError('AMBIGUOUS_ITEM')
+  bycode[code]=(no,item)
+ answers={}
+ for answer in json.loads(row.answers_json or '[]'):
+  key=str(answer.get('item_no'))
+  if key in answers:raise ValueError('AMBIGUOUS_ANSWER')
+  answers[key]=answer
+ for no,item in enumerate(current_checks):
+  old_item=bycode.get(item.get('item_code'))
+  if not old_item:continue
+  oldno,olddef=old_item
+  # Version changed semantic definition: do not transplant a value by ordinal/code alone.
+  if any(item.get(k)!=olddef.get(k) for k in ('content','input_type','choices','criteria','criteria_files','shaded','answer_required','comment_required','score_enabled')):continue
+  answer=answers.get(str(oldno))
+  if answer:result['values'][no]=str(answer.get('value') or '')
+ result.update(status=row.status,result_id=row.id)
+ return result
+HEADER='<th class="mobile-previous-month mobile-previous-date" aria-label="{{ previous.date }}">{{ previous.label }}</th>'
+CELL='<td class="mobile-previous-month mobile-previous-date" data-date="{{ previous.date }}">{{ previous["values"].get(item_no, "") or "-" }}</td>'
+# No data-day, form, hidden input, controls, or target-day override. CSS must hide this column on desktop.
+
+def for_view(vehicle,checklist_id,year,month,active_day,items):
+ from flask import session
+ from .models import VehicleChecklistResult
+ def load(company,vehicle,checklist_id,day):
+  return VehicleChecklistResult.query.filter_by(company_code=company,vehicle_record_id=vehicle,checklist_id=checklist_id,year=str(day.year),month=f'{day.month:02}',day=f'{day.day:02}').all()
+ return previous_month(company=session.get('company_code'),vehicle=vehicle,checklist_id=checklist_id,year=year,month=month,active_day=active_day,current_items=items,load=load)
