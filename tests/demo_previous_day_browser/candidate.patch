+  shared_entry=allowed is not None and all(k=='__aonagi_entry' or (k in allowed and len(request.args.getlist(k))==1) for k in request.args)
+  if shared_entry and request.endpoint=='vehicle_checklist_results':
+   try:
+    shared_entry=(int(request.args.get('vehicle_record_id',''))==target.vehicle and int((request.view_args or {}).get('index',-1))==target.checklist)
+    local_today=now.astimezone(ZoneInfo('Asia/Tokyo')).date()
+    selected=datetime(int(request.args.get('year',local_today.year)),int(request.args.get('month',local_today.month)),int(request.args.get('active_day',local_today.day)))
+    shared_entry=shared_entry and 2000<=selected.year<=2100
+   except (ValueError,TypeError):shared_entry=False
+ if (not (plain_entry or shared_entry)
+     or not cfg.get('PUBLIC_DEMO_CANDIDATE') or not cfg.get('PUBLIC_DEMO_SHARED_COMPANY')
